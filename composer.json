{
  "name": "mistralys/composer-local-switcher",
  "description": "PHP library that handles switching between live and local Composer dependencies using Composer scripts.",
  "license": "MIT",
  "type": "library",
  "homepage": "https://github.com/Mistralys/composer-local-switcher",
  "authors": [
    {
      "name": "Sebastian Mordziol",
      "email": "s.mordziol@mistralys.eu",
      "role": "Project Lead"
    }
  ],
  "support": {
    "issues": "https://github.com/Mistralys/composer-local-switcher/issues",
    "source": "https://github.com/Mistralys/composer-local-switcher"
  },
  "autoload": {
    "classmap": [
      "src/"
    ]
  },
  "autoload-dev": {
    "classmap": [
      "tests/TestClasses"
    ]
  },
  "require": {
    "php": ">=8.4"
  },
  "require-dev": {
    "phpstan/phpstan": ">=1.10",
    "phpstan/phpstan-phpunit": ">=1.3",
    "phpunit/phpunit": ">=13.0",
    "roave/security-advisories": "dev-latest",
    "symfony/process": "^7.0 || ^8.0"
  },
  "scripts": {
    "analyze": "php vendor/bin/phpstan analyse --configuration phpstan.neon --memory-limit=900M",
    "analyze-save": "php vendor/bin/phpstan analyse --configuration phpstan.neon --memory-limit=900M > phpstan-result.txt || true",
    "analyze-clear": "php vendor/bin/phpstan clear-result-cache",
    "test": "php vendor/bin/phpunit --testsuite \"Test suites\"",
    "test-integration": "php vendor/bin/phpunit --testsuite Integration",
    "test-file": "php vendor/bin/phpunit",
    "test-suite": "php vendor/bin/phpunit --testsuite",
    "test-filter": "php vendor/bin/phpunit --filter",
    "test-group": "php vendor/bin/phpunit --group"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
